{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account and player data for King of Deep",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The unique user ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "description": "Display name of the captain",
          "maxLength": 50
        },
        "email": {
          "type": "string",
          "description": "Email address of the player",
          "maxLength": 120
        },
        "avatar": {
          "type": "string",
          "description": "Avatar icon or image",
          "maxLength": 500
        },
        "gold": {
          "type": "number",
          "description": "Total gold coins"
        },
        "gems": {
          "type": "number",
          "description": "Total precious gems"
        },
        "redGems": {
          "type": "number",
          "description": "Total red gems"
        },
        "exp": {
          "type": "number",
          "description": "Experience points"
        },
        "server": {
          "type": "string",
          "description": "Active server region",
          "maxLength": 64
        },
        "pirateClass": {
          "type": "string",
          "description": "Player class title",
          "maxLength": 64
        },
        "tribeId": {
          "type": "string",
          "description": "ID of the tribe the user belongs to",
          "maxLength": 128
        },
        "tribeName": {
          "type": "string",
          "description": "Name of the tribe the user belongs to",
          "maxLength": 100
        },
        "portDestroyed": {
          "type": "boolean",
          "description": "Whether all ships in the harbor are destroyed"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp",
          "maxLength": 64
        }
      },
      "required": ["userId"]
    },
    "Tribe": {
      "title": "Tribe",
      "description": "Clans and tribes in King of Deep",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Tribe name",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Tribe motto and description",
          "maxLength": 500
        },
        "emblem": {
          "type": "string",
          "description": "Tribe icon or emoji",
          "maxLength": 64
        },
        "leaderId": {
          "type": "string",
          "description": "User ID of the tribe leader",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "leaderName": {
          "type": "string",
          "description": "Display name of the tribe leader",
          "maxLength": 64
        },
        "level": {
          "type": "number",
          "description": "Tribe level"
        },
        "power": {
          "type": "number",
          "description": "Total power points"
        },
        "donations": {
          "type": "number",
          "description": "Total gold donated"
        },
        "membersCount": {
          "type": "number",
          "description": "Number of members"
        },
        "members": {
          "type": "array",
          "description": "List of member user IDs"
        },
        "lastUpdated": {
          "type": "string",
          "description": "Last updated timestamp",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 64
        }
      },
      "required": ["name", "leaderId"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Global and clan chat messages",
      "type": "object",
      "properties": {
        "sender": { "type": "string", "maxLength": 64 },
        "senderId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "avatar": { "type": "string", "maxLength": 500 },
        "text": { "type": "string", "maxLength": 1000 },
        "time": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["senderId", "userId", "text", "createdAt"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Multiplayer friend requests between captains",
      "type": "object",
      "properties": {
        "senderId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "maxLength": 64 },
        "senderAvatar": { "type": "string", "maxLength": 500 },
        "receiverId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": {
          "type": "string",
          "enum": ["PENDING", "ACCEPTED", "DECLINED"],
          "maxLength": 20
        },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["senderId", "receiverId", "status", "createdAt"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Player support tickets",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 120 },
        "subject": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 2000 },
        "status": {
          "type": "string",
          "enum": ["open", "closed", "resolved"],
          "maxLength": 20
        },
        "createdAt": { "type": "string", "description": "Server timestamp" }
      },
      "required": ["userId", "subject", "message", "status", "createdAt"]
    },
    "HarborEvent": {
      "title": "HarborEvent",
      "description": "Asynchronous harbor attacks, repairs, donations, and messages",
      "type": "object",
      "properties": {
        "attackerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "attackerName": { "type": "string", "maxLength": 64 },
        "attackerAvatar": { "type": "string", "maxLength": 500 },
        "defenderId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "maxLength": 40 },
        "payload": { "type": "object" },
        "status": {
          "type": "string",
          "enum": ["PENDING", "PROCESSED", "RESOLVED"],
          "maxLength": 20
        },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["attackerId", "defenderId", "type", "status", "createdAt"]
    },
    "GlobalNotification": {
      "title": "GlobalNotification",
      "description": "Live global game event notifications broadcast across players",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ATTACK", "SUPPORT", "MILESTONE", "SYSTEM"],
          "maxLength": 32
        },
        "title": { "type": "string", "maxLength": 120 },
        "message": { "type": "string", "maxLength": 500 },
        "icon": { "type": "string", "maxLength": 64 },
        "authorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "maxLength": 64 },
        "senderName": { "type": "string", "maxLength": 64 },
        "targetName": { "type": "string", "maxLength": 64 },
        "targetId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["type", "title", "message", "authorId", "senderId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection storing player progress and profiles"
    },
    "/tribes/{tribeId}": {
      "schema": "Tribe",
      "description": "Collection storing clan and tribe information"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Collection storing public and tribe chat messages"
    },
    "/friendRequests/{requestId}": {
      "schema": "FriendRequest",
      "description": "Collection storing friend requests"
    },
    "/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Collection storing support tickets"
    },
    "/harborEvents/{eventId}": {
      "schema": "HarborEvent",
      "description": "Collection storing harbor events and raids"
    },
    "/globalNotifications/{notifId}": {
      "schema": "GlobalNotification",
      "description": "Collection storing global game notifications"
    }
  }
}
